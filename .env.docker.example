# SmartShop AI - Docker Compose environment
# Скопіюйте як .env.docker та за потреби заповніть реальні ключі
# cp .env.docker.example .env.docker

FLASK_ENV=production
DEBUG=False
SECRET_KEY=change_me_in_production_use_long_random_string_at_least_32_chars

DB_SCHEMA=smartshop

DEMO_MODE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OPENAI_API_KEY=

IMAGE_STORAGE=database

LOG_LEVEL=INFO

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartshop.local

BACKUP_ENABLED=False

B2B_AUTO_VERIFY=false
VAT_CHECK_ENABLED=true

# Postgres container credentials (also used by docker-compose.yml to build DATABASE_URL)
POSTGRES_DB=smartshop
POSTGRES_USER=smartshop
POSTGRES_PASSWORD=change_me
